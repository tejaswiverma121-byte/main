<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Courses | LearnHub</title>
    <link rel="stylesheet" href="/stylesheets/instructor.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 13, 35, 0.85);
            backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-card {
            background: #211C44;
            border-radius: 20px;
            width: 90%;
            max-width: 550px;
            padding: 35px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .modal-card h2 {
            margin-top: 0;
            font-size: 24px;
            margin-bottom: 20px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-card .close-btn {
            background: none;
            border: none;
            color: #9f9f9f;
            font-size: 22px;
            cursor: pointer;
            transition: 0.3s;
        }

        .modal-card .close-btn:hover {
            color: white;
        }

        .modal-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-form label {
            font-size: 13px;
            color: #BEBEBE;
            margin-bottom: -10px;
            font-weight: 500;
        }

        .modal-form input, .modal-form select, .modal-form textarea {
            background: #15132B;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
            width: 100%;
        }

        .modal-form input:focus, .modal-form select:focus, .modal-form textarea:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
        }

        .modal-form button[type="submit"] {
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
        }

        .modal-form button[type="submit"]:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

<div class="dashboard">

<!-- ================= SIDEBAR ================= -->
<aside class="sidebar">
    <div>
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <li>
                <a href="/dashboard/instructor" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>
            </li>
            <li class="active">
                <i class="fa-solid fa-book-open"></i>
                My Courses
            </li>
            <li>
                <a href="/dashboard/instructor/students" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-users"></i>
                    Students
                </a>
            </li>
            <li><i class="fa-regular fa-message"></i> Messages</li>
            <li><i class="fa-regular fa-user"></i> Profile</li>
        </ul>
    </div>

    <a href="/logout" class="logout">
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
    </a>
</aside>

<!-- ================= MAIN ================= -->
<main class="main">
    <div class="topbar">
        <div>
            <h1>My Courses 📚</h1>
            <p>Manage, edit, and create your course content.</p>
        </div>
        <div class="profile">
            <i class="fa-regular fa-bell"></i>
            <img src="https://i.pravatar.cc/100?img=15">
        </div>
    </div>

    <div class="table-header">
        <h2>All Courses</h2>
        <button onclick="openCreateModal()">
            <i class="fa-solid fa-plus"></i>
            Create New Course
        </button>
    </div>

    <table>
        <thead>
            <tr>
                <th>Course</th>
                <th>Category</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                    <tr id="course-row-<%= course._id %>">
                        <td>
            <div style="display: flex; align-items: center; gap: 12px;">
                    <img src="<%= course.thumbnail %>" style="width: 50px; height: 35px; border-radius: 6px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500'">
            <div>
            <a href="/dashboard/instructor/courses/<%= course._id %>/lectures" style="color:white; text-decoration:none; font-weight:bold;">
                <%= course.title %>
            </a>
        </div>
    </div>
</td>
                        <td><%= course.category %></td>
                        <td>₹<%= course.price %></td>
                        <td>
                            <% if (course.status === 'Published') { %>
                                <span class="published">Published</span>
                            <% } else { %>
                                <span class="draft">Draft</span>
                            <% } %>
                        </td>
                        <td>
                            <button class="action" onclick='openEditModal(<%= JSON.stringify(course) %>)'>
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="action" onclick="deleteCourse('<%= course._id %>')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: #BEBEBE; padding: 30px;">
                        You haven't created any courses yet. Click <strong>Create New Course</strong> to get started!
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>

</main>

</div>

<!-- ================= CREATE COURSE MODAL ================= -->
<div class="modal-overlay" id="createCourseModal">
    <div class="modal-card">
        <h2>
            <span><i class="fa-solid fa-plus" style="color: #8B5CF6; margin-right: 8px;"></i> Create Course</span>
            <button class="close-btn" onclick="closeCreateModal()">✕</button>
        </h2>
        <form action="/courses/create" method="POST" class="modal-form">
            <label>Course Title</label>
            <input type="text" name="title" placeholder="e.g. Master React & Node.js" required>

            <label>Category</label>
            <select name="category" required>
                <option value="Development">Development</option>
                <option value="Design">Design</option>
                <option value="Data Science">Data Science</option>
                <option value="Business">Business</option>
                <option value="Marketing">Marketing</option>
            </select>

            <label>Price (₹)</label>
            <input type="number" name="price" placeholder="499" min="0" required>

            <label>Thumbnail Image URL</label>
            <input type="url" name="thumbnail" placeholder="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500">

            <label>Status</label>
            <select name="status">
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
            </select>

            <label>Course Description</label>
            <textarea name="description" rows="3" placeholder="Description of your course content..." required></textarea>

            <button type="submit">Create Course</button>
        </form>
    </div>
</div>

<!-- ================= EDIT COURSE MODAL ================= -->
<div class="modal-overlay" id="editCourseModal">
    <div class="modal-card">
        <h2>
            <span><i class="fa-solid fa-pen" style="color: #8B5CF6; margin-right: 8px;"></i> Edit Course</span>
            <button class="close-btn" onclick="closeEditModal()">✕</button>
        </h2>
        <form id="editCourseForm" method="POST" class="modal-form">
            <label>Course Title</label>
            <input type="text" id="editTitle" name="title" required>

            <label>Category</label>
            <select id="editCategory" name="category" required>
                <option value="Development">Development</option>
                <option value="Design">Design</option>
                <option value="Data Science">Data Science</option>
                <option value="Business">Business</option>
                <option value="Marketing">Marketing</option>
            </select>

            <label>Price (₹)</label>
            <input type="number" id="editPrice" name="price" min="0" required>

            <label>Thumbnail Image URL</label>
            <input type="url" id="editThumbnail" name="thumbnail">

            <label>Status</label>
            <select id="editStatus" name="status">
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
            </select>

            <label>Course Description</label>
            <textarea id="editDescription" name="description" rows="3" required></textarea>

            <button type="submit">Save Changes</button>
        </form>
    </div>
</div>

<script>
function openCreateModal() {
    document.getElementById('createCourseModal').style.display = 'flex';
}

function closeCreateModal() {
    document.getElementById('createCourseModal').style.display = 'none';
}

function openEditModal(course) {
    document.getElementById('editCourseForm').action = `/courses/edit/${course._id}`;
    document.getElementById('editTitle').value = course.title || '';
    document.getElementById('editCategory').value = course.category || 'Development';
    document.getElementById('editPrice').value = course.price || 0;
    document.getElementById('editThumbnail').value = course.thumbnail || '';
    document.getElementById('editStatus').value = course.status || 'Published';
    document.getElementById('editDescription').value = course.description || '';
    document.getElementById('editCourseModal').style.display = 'flex';
}

function closeEditModal() {
    document.getElementById('editCourseModal').style.display = 'none';
}

async function deleteCourse(id) {
    if (!confirm('Are you sure you want to delete this course?')) return;
    try {
        const response = await fetch(`/courses/delete/${id}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            const row = document.getElementById(`course-row-${id}`);
            if (row) row.remove();
        } else {
            alert('Failed to delete course. Please try again.');
        }
    } catch (err) {
        console.error('Error deleting course:', err);
        alert('An error occurred. Please try again.');
    }
}
</script>

</body>
</html>