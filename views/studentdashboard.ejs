<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LearnHub Dashboard</title>

    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">

            <i class="fa-solid fa-graduation-cap"></i>

            <span>LearnHub</span>

        </div>

        <ul>
            <a href="/dashboard/student">
                <li class="active">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li>
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li>
                    <i class="fa-regular fa-heart"></i>
                    Wishlist
                </li>
            </a>

            
            <li>
                <i class="fa-regular fa-message"></i>
                Messages
            </li>

            <a href="/student/profile">
                <li>
                    <i class="fa-regular fa-user"></i>
                    Profile
                </li>
            </a>
        </ul>

        <a href="/logout" class="logout"> <i class="fa-solid fa-right-from-bracket"></i>Logout</a>

    </aside>



    <!-- ================= MAIN CONTENT ================= -->

    <main class="main">

        <!-- Top Bar -->

        <div class="topbar">

            <div>

                <h1>

                    Welcome Back,

                    <%= user.username %> 👋

                </h1>

                <p>

                    Keep learning and grow your skills every day.

                </p>

            </div>

            <div class="profile">

                <i class="fa-regular fa-bell"></i>

                <a href="/student/profile" style="display:inline-block; border-radius: 50%; border: 3px solid #8B5CF6;">
                    <img
                    src="<%= user.profilePic && user.profilePic.trim() !== '' ? user.profilePic : 'https://i.pravatar.cc/100?img=32' %>"
                    alt="profile"
                    style="width:55px; height:55px; border-radius:50%; display:block;">
                </a>

            </div>

        </div>



        <!-- Search -->

        <div class="search">

            <input

            type="text"

            placeholder="Search for courses...">

            <i class="fa-solid fa-magnifying-glass"></i>

        </div>



        <!-- Available Courses -->

        <div class="section-header">
            <h2>Available Courses</h2>
        </div>

        <!-- Course Cards -->
        <div class="courses">
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => {
                const isWishlisted = user.wishlist && user.wishlist.some(id => id.toString() === course._id.toString());
                const isPurchased = user.purchasedCourses && user.purchasedCourses.some(id => id.toString() === course._id.toString());
            %>
                    <div class="course-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                        <!-- Wishlist Heart Button -->
                        <button
                            class="wishlist-btn <%= isWishlisted ? 'active' : '' %>"
                            data-course-id="<%= course._id %>"
                            onclick="toggleWishlist(this, '<%= course._id %>')"
                            title="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
                        >
                            <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                        </button>

                        <div>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">
                            <h3 style="margin-top: 10px; font-size: 20px;"><%= course.title %></h3>
                            <p style="font-size: 14px; color: #BEBEBE; line-height: 1.5; margin-bottom: 15px;"><%= course.description.substring(0, 80) %><%= course.description.length > 80 ? '...' : '' %></p>
                        </div>
                        <div>
                            <div class="course-card-details">
                                <span class="instructor-name">By: <%= course.instructorName %></span>
                                <span class="price"><%= course.price === 0 ? 'Free' : '\u20b9' + course.price %></span>
                            </div>

                            <% if (isPurchased) { %>
                                <button class="enroll-btn enrolled" disabled>✓ Enrolled</button>
                            <% } else { %>
                                <form action="/student/buy/<%= course._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="enroll-btn">Enroll / Buy</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-courses-msg">
                    <i class="fa-solid fa-book" style="font-size: 40px; color: #8B5CF6; margin-bottom: 15px; display: block;"></i>
                    No courses available right now. Please check back later!
                </div>
            <% } %>
        </div>

    </main>

</div>

<script>
async function toggleWishlist(btn, courseId) {
    try {
        const response = await fetch(`/student/wishlist/toggle/${courseId}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success) {
            const icon = btn.querySelector('i');
            if (data.wishlisted) {
                btn.classList.add('active');
                icon.classList.remove('fa-regular');
                icon.classList.add('fa-solid');
                btn.title = 'Remove from Wishlist';
            } else {
                btn.classList.remove('active');
                icon.classList.remove('fa-solid');
                icon.classList.add('fa-regular');
                btn.title = 'Add to Wishlist';
            }
        }
    } catch (err) {
        console.error('Wishlist toggle failed:', err);
    }
}
</script>

</body>

</html>