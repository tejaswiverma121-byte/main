<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LearnHub Dashboard</title>

    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        .wishlist-btn-heart {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(15, 13, 35, 0.6);
            border: none;
            color: #EF4444;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            cursor: pointer;
            backdrop-filter: blur(4px);
            transition: transform 0.2s ease, background 0.2s ease;
            z-index: 10;
        }
        .wishlist-btn-heart:hover {
            transform: scale(1.1);
            background: rgba(15, 13, 35, 0.85);
        }
        .wishlist-btn-heart.inactive {
            color: rgba(255, 255, 255, 0.6);
        }
        .wishlist-btn-heart.active {
            color: #EF4444;
        }
        .sidebar-badge {
            background: #EF4444;
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: auto;
        }
    </style>
</head>

<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div class="logo">

            <i class="fa-solid fa-graduation-cap"></i>

            <span>LearnHub</span>

        </div>

        <ul>
            <a href="/dashboard/student">
                <li class="active">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li>
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li>
                    <i class="fa-regular fa-heart"></i>
                    Wishlist
                    <span id="wishlist-count-badge" class="sidebar-badge"><%= (user.wishlist && user.wishlist.length) || 0 %></span>
                </li>
            </a>

            <a href="/messages" style="text-decoration:none; color:inherit;">
                <li>
                    <i class="fa-regular fa-message"></i>
                    Messages
                </li>
            </a>

            <li class="sidebar-profile-trigger" onclick="openProfileModal()">
                <i class="fa-regular fa-user"></i>
                Profile
            </li>
        </ul>

        <a href="/logout" class="logout"> <i class="fa-solid fa-right-from-bracket"></i>Logout</a>

    </aside>



    <!-- ================= MAIN CONTENT ================= -->

    <main class="main">

        <!-- Top Bar -->

        <div class="topbar">

            <div>

                <h1>

                    Welcome Back,

                    <%= user.username %> 👋

                </h1>

                <p>

                    Keep learning and grow your skills every day.

                </p>

            </div>

            <div class="profile" style="position:relative;">
                <div class="profile-avatar-wrap" id="profileAvatarWrap">
                    <div class="avatar-initials"></div>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-avatar-lg"></div>
                            <div>
                                <div class="dropdown-name"><%= user.username %></div>
                                <div class="dropdown-role"><%= user.role %></div>
                            </div>
                        </div>
                        <span class="dropdown-item" onclick="openProfileModal()">
                            <i class="fa-regular fa-user"></i> View Profile
                        </span>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item danger">
                            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>

        </div>



        <!-- Search -->

        <div class="search">

            <input
            id="course-search-input"
            type="text"
            placeholder="Search for courses..."
            onkeyup="filterDashboardCourses()">

            <i class="fa-solid fa-magnifying-glass"></i>

        </div>



        <!-- Available Courses -->

        <div class="section-header">
            <h2>Available Courses</h2>
        </div>

        <!-- Course Cards -->
        <div class="courses">
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                    <div class="course-card" style="display: flex; flex-direction: column; justify-content: space-between; position: relative;">
                        <!-- Wishlist toggle heart button -->
                        <% const isWishlisted = user.wishlist && user.wishlist.some(cId => cId && (cId._id ? cId._id.toString() : cId.toString()) === course._id.toString()); %>
                        <button class="wishlist-btn-heart <%= isWishlisted ? 'active' : 'inactive' %>" onclick="toggleWishlist(this, '<%= course._id %>')" title="<%= isWishlisted ? 'Remove from Wishlist' : 'Add to Wishlist' %>">
                            <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                        </button>
                        <div>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">
                            <h3 style="margin-top: 10px; font-size: 20px;"><%= course.title %></h3>
                            <p style="font-size: 14px; color: #BEBEBE; line-height: 1.5; margin-bottom: 15px;"><%= course.description.substring(0, 80) %><%= course.description.length > 80 ? '...' : '' %></p>
                        </div>
                        <div>
                            <div class="course-card-details">
                                <span class="instructor-name">By: <%= course.instructorName %></span>
                                <span class="price"><%= course.price === 0 ? 'Free' : '₹' + course.price %></span>
                            </div>
                            
                            <% if (user.purchasedCourses && user.purchasedCourses.some(cId => cId && (cId._id ? cId._id.toString() : cId.toString()) === course._id.toString())) { %>
                                <a href="/student/course/<%= course._id %>" class="enroll-btn enrolled" style="text-decoration: none; text-align: center; display: block;">▶ Watch Lectures</a>
                            <% } else { %>
                                <form action="/student/buy/<%= course._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="enroll-btn">Enroll / Buy</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-courses-msg">
                    <i class="fa-solid fa-book" style="font-size: 40px; color: #8B5CF6; margin-bottom: 15px; display: block;"></i>
                    No courses available right now. Please check back later!
                </div>
            <% } %>
        </div>

    </main>

</div>

<%- include('partials/profile-modal') %>

<script>
function filterDashboardCourses() {
    const query = document.getElementById('course-search-input').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.courses .course-card');
    cards.forEach(card => {
        const title = card.querySelector('h3') ? card.querySelector('h3').textContent.toLowerCase() : '';
        const desc = card.querySelector('p') ? card.querySelector('p').textContent.toLowerCase() : '';
        if (title.includes(query) || desc.includes(query)) {
            card.style.display = 'flex';
        } else {
            card.style.display = 'none';
        }
    });
}

async function toggleWishlist(btn, courseId) {
    try {
        const response = await fetch(`/student/wishlist/toggle/${courseId}`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        const data = await response.json();
        if (data.success) {
            const icon = btn.querySelector('i');
            if (data.added) {
                btn.classList.remove('inactive');
                btn.classList.add('active');
                btn.title = 'Remove from Wishlist';
                icon.className = 'fa-solid fa-heart';
            } else {
                btn.classList.remove('active');
                btn.classList.add('inactive');
                btn.title = 'Add to Wishlist';
                icon.className = 'fa-regular fa-heart';
            }
            if (typeof data.wishlistCount !== 'undefined') {
                const badge = document.getElementById('wishlist-count-badge');
                if (badge) {
                    badge.textContent = data.wishlistCount;
                }
            }
        }
    } catch (err) {
        console.error('Error toggling wishlist:', err);
    }
}
</script>

</body>

</html>