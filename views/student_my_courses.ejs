<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub | My Courses</title>
    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .sidebar-badge {
            background: #EF4444;
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: auto;
        }
    </style>
</head>
<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <a href="/dashboard/student">
                <li>
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li class="active">
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li>
                    <i class="fa-regular fa-heart"></i>
                    Wishlist
                    <span class="sidebar-badge"><%= (user.wishlist && user.wishlist.length) || 0 %></span>
                </li>
            </a>

            <a href="/messages" style="text-decoration:none; color:inherit;">
                <li>
                    <i class="fa-regular fa-message"></i>
                    Messages
                </li>
            </a>

            <li class="sidebar-profile-trigger" onclick="openProfileModal()">
                <i class="fa-regular fa-user"></i>
                Profile
            </li>
        </ul>

        <a href="/logout" class="logout"> <i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main">
        <!-- Top Bar -->
        <div class="topbar">
            <div>
                <h1>My Courses</h1>
                <p>Pick up right where you left off!</p>
            </div>
            <div class="profile" style="position:relative;">
                <div class="profile-avatar-wrap" id="profileAvatarWrap">
                    <div class="avatar-initials"></div>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-avatar-lg"></div>
                            <div>
                                <div class="dropdown-name"><%= user.username %></div>
                                <div class="dropdown-role"><%= user.role %></div>
                            </div>
                        </div>
                        <span class="dropdown-item" onclick="openProfileModal()">
                            <i class="fa-regular fa-user"></i> View Profile
                        </span>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item danger">
                            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Cards -->
        <div class="courses">
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                    <div class="course-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">
                            <h3 style="margin-top: 10px; font-size: 20px;"><%= course.title %></h3>
                            <p style="font-size: 14px; color: #BEBEBE; line-height: 1.5; margin-bottom: 15px;"><%= course.description.substring(0, 80) %><%= course.description.length > 80 ? '...' : '' %></p>
                        </div>
                        <div>
                            <div class="course-card-details">
                                <span class="instructor-name">By: <%= course.instructorName %></span>
                            </div>
                            
                            <a href="/student/course/<%= course._id %>" class="enroll-btn" style="background: linear-gradient(135deg, #10B981, #059669); margin-top: 15px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2); text-decoration: none; text-align: center; display: block;">Resume Learning</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-courses-msg">
                    <i class="fa-solid fa-graduation-cap" style="font-size: 40px; color: #8B5CF6; margin-bottom: 15px; display: block;"></i>
                    You haven't bought/enrolled in any courses yet.
                    <a href="/dashboard/student" style="color: #8B5CF6; font-weight: 600; text-decoration: underline; display: block; margin-top: 15px;">Browse Available Courses</a>
                </div>
            <% } %>
        </div>
    </main>

</div>

<%- include('partials/profile-modal') %>

</body>
</html>
