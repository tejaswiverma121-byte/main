<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub | Wishlist</title>
    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .wishlist-btn-heart {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(15, 13, 35, 0.6);
            border: none;
            color: #EF4444;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            cursor: pointer;
            backdrop-filter: blur(4px);
            transition: transform 0.2s ease, background 0.2s ease;
            z-index: 10;
        }
        .wishlist-btn-heart:hover {
            transform: scale(1.1);
            background: rgba(15, 13, 35, 0.85);
        }
        .sidebar-badge {
            background: #EF4444;
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: auto;
        }
    </style>
</head>
<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <a href="/dashboard/student">
                <li>
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li>
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li class="active">
                    <i class="fa-solid fa-heart" style="color: #EF4444;"></i>
                    Wishlist
                    <span id="wishlist-count-badge" class="sidebar-badge"><%= (locals.courses && courses.length) || 0 %></span>
                </li>
            </a>

            <li>
                <i class="fa-solid fa-chart-line"></i>
                Progress
            </li>

            <a href="/messages" style="text-decoration:none; color:inherit;">
                <li>
                    <i class="fa-regular fa-message"></i>
                    Messages
                </li>
            </a>

            <li class="sidebar-profile-trigger" onclick="openProfileModal()">
                <i class="fa-regular fa-user"></i>
                Profile
            </li>
        </ul>

        <a href="/logout" class="logout"> <i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main">
        <!-- Top Bar -->
        <div class="topbar">
            <div>
                <h1>My Wishlist ❤️</h1>
                <p>Courses you are interested in!</p>
            </div>
            <div class="profile" style="position:relative;">
                <div class="profile-avatar-wrap" id="profileAvatarWrap">
                    <div class="avatar-initials"></div>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-avatar-lg"></div>
                            <div>
                                <div class="dropdown-name"><%= user.username %></div>
                                <div class="dropdown-role"><%= user.role %></div>
                            </div>
                        </div>
                        <span class="dropdown-item" onclick="openProfileModal()">
                            <i class="fa-regular fa-user"></i> View Profile
                        </span>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item danger">
                            <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Cards -->
        <div class="courses">
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                    <% if (course) { %>
                    <div class="course-card" id="course-card-<%= course._id %>" style="display: flex; flex-direction: column; justify-content: space-between; position: relative;">
                        
                        <!-- Remove from Wishlist button -->
                        <button class="wishlist-btn-heart" onclick="removeFromWishlist('<%= course._id %>')" title="Remove from Wishlist">
                            <i class="fa-solid fa-heart"></i>
                        </button>

                        <div>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">
                            <h3 style="margin-top: 10px; font-size: 20px;"><%= course.title %></h3>
                            <p style="font-size: 14px; color: #BEBEBE; line-height: 1.5; margin-bottom: 15px;"><%= course.description ? (course.description.substring(0, 80) + (course.description.length > 80 ? '...' : '')) : '' %></p>
                        </div>
                        <div>
                            <div class="course-card-details">
                                <span class="instructor-name">By: <%= course.instructorName %></span>
                                <span class="price"><%= course.price === 0 ? 'Free' : '₹' + course.price %></span>
                            </div>
                            
                            <% if (user.purchasedCourses && user.purchasedCourses.some(cId => cId && (cId._id ? cId._id.toString() : cId.toString()) === course._id.toString())) { %>
                                <button class="enroll-btn enrolled" disabled style="margin-top: 15px;">✓ Enrolled</button>
                            <% } else { %>
                                <form action="/student/buy/<%= course._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="enroll-btn" style="margin-top: 15px;">Enroll / Buy</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                <% }) %>
            <% } else { %>
                <div class="no-courses-msg" style="grid-column: 1 / -1; text-align: center; padding: 50px 0;">
                    <i class="fa-regular fa-heart" style="font-size: 40px; color: #EF4444; margin-bottom: 15px; display: block;"></i>
                    Your wishlist is empty.
                    <a href="/dashboard/student" style="color: #8B5CF6; font-weight: 600; text-decoration: underline; display: block; margin-top: 15px;">Browse Available Courses</a>
                </div>
            <% } %>
        </div>
    </main>

</div>

<%- include('partials/profile-modal') %>

<script>
async function removeFromWishlist(courseId) {
    try {
        const response = await fetch(`/student/wishlist/toggle/${courseId}`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            }
        });
        const data = await response.json();
        if (data.success && !data.added) {
            // Remove the card from the UI
            const card = document.getElementById(`course-card-${courseId}`);
            if (card) {
                card.remove();
            }
            if (typeof data.wishlistCount !== 'undefined') {
                const badge = document.getElementById('wishlist-count-badge');
                if (badge) {
                    badge.textContent = data.wishlistCount;
                }
            }
            // Check if there are no more cards, show empty message
            const coursesDiv = document.querySelector('.courses');
            const remainingCards = coursesDiv ? coursesDiv.querySelectorAll('.course-card') : [];
            if (coursesDiv && remainingCards.length === 0) {
                coursesDiv.innerHTML = `
                    <div class="no-courses-msg" style="grid-column: 1 / -1; text-align: center; padding: 50px 0;">
                        <i class="fa-regular fa-heart" style="font-size: 40px; color: #EF4444; margin-bottom: 15px; display: block;"></i>
                        Your wishlist is empty.
                        <a href="/dashboard/student" style="color: #8B5CF6; font-weight: 600; text-decoration: underline; display: block; margin-top: 15px;">Browse Available Courses</a>
                    </div>
                `;
            }
        }
    } catch (err) {
        console.error('Error removing from wishlist:', err);
    }
}
</script>

</body>
</html>
