<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub | Wishlist</title>
    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>
<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <a href="/dashboard/student">
                <li>
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li>
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li class="active">
                    <i class="fa-solid fa-heart"></i>
                    Wishlist
                </li>
            </a>

            <li>
                <i class="fa-regular fa-message"></i>
                Messages
            </li>

            <li>
                <i class="fa-regular fa-user"></i>
                Profile
            </li>
        </ul>

        <a href="/logout" class="logout"> <i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main">
        <!-- Top Bar -->
        <div class="topbar">
            <div>
                <h1>My Wishlist <i class="fa-solid fa-heart" style="color: #EF4444; font-size: 30px; margin-left: 10px; vertical-align: middle;"></i></h1>
                <p>Courses you've saved for later.</p>
            </div>
            <div class="profile">
                <i class="fa-regular fa-bell"></i>
                <img src="https://i.pravatar.cc/100?img=32" alt="profile">
            </div>
        </div>

        <!-- Course Cards -->
        <div class="courses">
            <% if (locals.courses && courses.length > 0) { %>
                <% courses.forEach(course => {
                    const isPurchased = user.purchasedCourses && user.purchasedCourses.some(id => id.toString() === course._id.toString());
                %>
                    <div class="course-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                        <!-- Wishlist Remove Button -->
                        <button
                            class="wishlist-btn active"
                            data-course-id="<%= course._id %>"
                            onclick="toggleWishlist(this, '<%= course._id %>')"
                            title="Remove from Wishlist"
                        >
                            <i class="fa-solid fa-heart"></i>
                        </button>

                        <div>
                            <img src="<%= course.thumbnail %>" alt="<%= course.title %>" style="width: 100%; height: 160px; object-fit: cover; border-radius: 12px; margin-bottom: 15px;">
                            <h3 style="margin-top: 10px; font-size: 20px;"><%= course.title %></h3>
                            <p style="font-size: 14px; color: #BEBEBE; line-height: 1.5; margin-bottom: 15px;"><%= course.description.substring(0, 80) %><%= course.description.length > 80 ? '...' : '' %></p>
                        </div>
                        <div>
                            <div class="course-card-details">
                                <span class="instructor-name">By: <%= course.instructorName %></span>
                                <span class="price"><%= course.price === 0 ? 'Free' : '\u20b9' + course.price %></span>
                            </div>

                            <% if (isPurchased) { %>
                                <button class="enroll-btn enrolled" disabled>&#10003; Enrolled</button>
                            <% } else { %>
                                <form action="/student/buy/<%= course._id %>" method="POST" style="margin: 0;">
                                    <button type="submit" class="enroll-btn">Enroll / Buy</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-courses-msg">
                    <i class="fa-regular fa-heart" style="font-size: 40px; color: #EF4444; margin-bottom: 15px; display: block;"></i>
                    Your wishlist is empty!
                    <a href="/dashboard/student" style="color: #8B5CF6; font-weight: 600; text-decoration: underline; display: block; margin-top: 15px;">Browse Available Courses</a>
                </div>
            <% } %>
        </div>
    </main>

</div>

<script>
async function toggleWishlist(btn, courseId) {
    try {
        const response = await fetch(`/student/wishlist/toggle/${courseId}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        if (data.success && !data.wishlisted) {
            // Removed from wishlist — fade the card out and remove it
            const card = btn.closest('.course-card');
            if (card) {
                card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    card.remove();
                    const remaining = document.querySelectorAll('.course-card');
                    if (remaining.length === 0) {
                        document.querySelector('.courses').innerHTML = `
                            <div class="no-courses-msg">
                                <i class="fa-regular fa-heart" style="font-size: 40px; color: #EF4444; margin-bottom: 15px; display: block;"></i>
                                Your wishlist is empty!
                                <a href="/dashboard/student" style="color: #8B5CF6; font-weight: 600; text-decoration: underline; display: block; margin-top: 15px;">Browse Available Courses</a>
                            </div>
                        `;
                    }
                }, 400);
            }
        }
    } catch (err) {
        console.error('Wishlist toggle failed:', err);
    }
}
</script>

</body>
</html>
