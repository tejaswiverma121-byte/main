<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instructor Dashboard | LearnHub</title>
    <link rel="stylesheet" href="/stylesheets/instructor.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .stat-card {
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(139, 92, 246, 0.25);
        }

        .empty-state {
            margin-top: 50px;
            background: rgba(255,255,255,0.03);
            border: 1px dashed rgba(255,255,255,0.15);
            border-radius: 16px;
            padding: 60px 40px;
            text-align: center;
        }

        .empty-state i {
            font-size: 42px;
            color: #8B5CF6;
            margin-bottom: 18px;
        }

        .empty-state h3 {
            color: white;
            font-size: 22px;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #BEBEBE;
            margin-bottom: 22px;
        }

        .empty-state a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            padding: 13px 28px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .empty-state a:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
        }
    </style>
</head>
<body>

<div class="dashboard">

<!-- ================= SIDEBAR ================= -->
<aside class="sidebar">
    <div>
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <li class="active">
                <i class="fa-solid fa-house"></i>
                Dashboard
            </li>
            <li>
                <a href="/dashboard/instructor/courses" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </a>
            </li>

            <li>
                <a href="/dashboard/instructor/students" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-users"></i>
                    Students
                </a>
            </li>
            <li>
                <a href="/messages" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-regular fa-message"></i>
                    Messages
                </a>
            </li>
            <li class="sidebar-profile-trigger" onclick="openProfileModal()"><i class="fa-regular fa-user"></i> Profile</li>
        </ul>
    </div>

    <a href="/logout" class="logout">
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
    </a>
</aside>

<!-- ================= MAIN ================= -->
<main class="main">
    <div class="topbar">
        <div>
            <h1>Welcome Back, <%= user.username %> 👋</h1>
            <p>Manage your courses and inspire thousands of learners.</p>
        </div>
        <div class="profile" style="position:relative;">
            <i class="fa-regular fa-bell" style="cursor:default;"></i>
            <!-- Avatar with dropdown -->
            <div class="profile-avatar-wrap" id="profileAvatarWrap">
                <div class="avatar-initials"></div>
                <div class="profile-dropdown" id="profileDropdown">
                    <div class="dropdown-header">
                        <div class="dropdown-avatar-lg"></div>
                        <div>
                            <div class="dropdown-name"><%= user.username %></div>
                            <div class="dropdown-role"><%= user.role %></div>
                        </div>
                    </div>
                    <span class="dropdown-item" onclick="openProfileModal()">
                        <i class="fa-regular fa-user"></i> View Profile
                    </span>
                    <div class="dropdown-divider"></div>
                    <a href="/logout" class="dropdown-item danger">
                        <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= STATS ================= -->
    <div class="stats">
        <div class="stat-card" onclick="window.location.href='/dashboard/instructor/courses'">
            <div>
                <h4>Total Courses</h4>
                <h2><%= typeof totalCourses !== 'undefined' ? totalCourses : (courses ? courses.length : 0) %></h2>
            </div>
            <i class="fa-solid fa-book"></i>
        </div>

        <div class="stat-card" onclick="window.location.href='/dashboard/instructor/students'">
            <div>
                <h4>Total Students</h4>
                <h2><%= locals.enrollments ? enrollments.length : 0 %></h2>
            </div>
            <i class="fa-solid fa-users"></i>
        </div>

        <div class="stat-card">
            <div>
                <h4>Rating</h4>
                <h2>
                    <% if (locals.courses && courses.length > 0) { %>
                        Not rated yet
                    <% } else { %>
                        —
                    <% } %>
                </h2>
            </div>
            <i class="fa-solid fa-star"></i>
        </div>
    </div>

    <!-- ================= EMPTY STATE (only if no courses) ================= -->
    <% if (!locals.courses || courses.length === 0) { %>
        <div class="empty-state">
            <i class="fa-solid fa-book-open"></i>
            <h3>You haven't created any courses yet</h3>
            <p>Start building your first course and share your knowledge with students.</p>
            <a href="/dashboard/instructor/courses">
                <i class="fa-solid fa-plus"></i>
                Create Your First Course
            </a>
        </div>
    <% } %>

</main>

</div>

<%- include('partials/profile-modal') %>

</body>
</html>