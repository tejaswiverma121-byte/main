<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Not Found | LearnHub</title>

    <link rel="stylesheet" href="/stylesheets/usernotfound.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="card">

        <div class="icon">
            👤
        </div>

        <h1>User Not Found</h1>

        <p>
            We couldn't find an account associated with the email address you entered.
            Please check your email or create a new LearnHub account.
        </p>

        <div class="buttons">
            <a href="/login" class="login-btn">Try Again</a>
            <a href="/create" class="create-btn">Create Account</a>
        </div>

    </div>

</body>
</html>