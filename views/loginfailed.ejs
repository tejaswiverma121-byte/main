<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Login Failed' %> | LearnHub</title>

    <link rel="stylesheet" href="/stylesheets/loginfailed.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="error-card">

        <div class="error-icon">
            ✖
        </div>

        <h1><%= typeof title !== 'undefined' ? title : 'Login Failed' %></h1>

        <p>
            <%= typeof message !== 'undefined' ? message : "We couldn't verify your credentials. Please check your email and password, then try again." %>
        </p>

        <div class="btn-group">
            <a href="<%= typeof retryUrl !== 'undefined' ? retryUrl : '/' %>" class="retry-btn">Try Again</a>
            <a href="/" class="home-btn">Home</a>
        </div>

    </div>

</body>
</html>