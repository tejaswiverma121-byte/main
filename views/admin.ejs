<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>LearnHub Admin Dashboard</title>

    <link rel="stylesheet"
        href="/stylesheets/admin.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>

<div class="dashboard">

<!-- ================= SIDEBAR ================= -->

<aside class="sidebar">

<div>

<div class="logo">

<i class="fa-solid fa-graduation-cap"></i>

<span>LearnHub</span>

</div>

<ul>
<a href="/dashboard/admin">
    <li class="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>">
        <i class="fa-solid fa-house"></i>
        Dashboard
    </li>
</a>

<a href="/admin/students">
    <li class="<%= (typeof activePage !== 'undefined' && activePage === 'students') ? 'active' : '' %>">
        <i class="fa-solid fa-graduation-cap"></i>
        Students
    </li>
</a>

<a href="/admin/instructors">
    <li class="<%= (typeof activePage !== 'undefined' && activePage === 'instructors') ? 'active' : '' %>">
        <i class="fa-solid fa-chalkboard-user"></i>
        Instructors
    </li>
</a>

<li>
    <i class="fa-solid fa-book"></i>
    Courses
</li>

<li>
    <i class="fa-solid fa-chart-column"></i>
    Reports
</li>

<li>
    <i class="fa-solid fa-layer-group"></i>
    Categories
</li>

<li>
    <i class="fa-solid fa-gear"></i>
    Settings
</li>
</ul>

</div>

<a href="/logout" class="logout">

<i class="fa-solid fa-right-from-bracket"></i>

Logout

</a>

</aside>

<!-- ================= MAIN ================= -->

<main class="main">

<div class="topbar">

<div>

<h1>

Admin Dashboard

</h1>

<p>

Welcome,

<%= user.username %>

👋

</p>

</div>

<div class="profile">

<i class="fa-regular fa-bell"></i>

<img
src="https://i.pravatar.cc/100?img=12">

</div>

</div>

<!-- ================= STATISTICS ================= -->

<div class="stats">

<div class="stat-card">

<div>

<h4>Total Users</h4>

<h2><%= typeof totalUsers !== 'undefined' ? totalUsers : '—' %></h2>

<span class="green">Platform Members</span>

</div>

<div class="icon purple">

<i class="fa-solid fa-users"></i>

</div>

</div>

<div class="stat-card">

<div>

<h4>Instructors</h4>

<h2><%= typeof totalInstructors !== 'undefined' ? totalInstructors : '—' %></h2>

<span class="green">Approved + Pending</span>

</div>

<div class="icon blue">

<i class="fa-solid fa-chalkboard-user"></i>

</div>

</div>

<div class="stat-card">

<div>

<h4>Students</h4>

<h2><%= typeof totalStudents !== 'undefined' ? totalStudents : '—' %></h2>

<span class="green">Registered Learners</span>

</div>

<div class="icon green-bg">

<i class="fa-solid fa-graduation-cap"></i>

</div>

</div>

<div class="stat-card">

<div>

<h4>Revenue</h4>

<h2>₹12,45,320</h2>

<span class="green">+18%</span>

</div>

</div>

</div>

<!-- ================= PENDING INSTRUCTORS ================= -->
<div class="recent-users" style="margin-bottom: 40px; width: 100%;">
    <h2>Pending Instructor Approvals</h2>
    <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 20px;">
        <% if (locals.pendingInstructors && pendingInstructors.length > 0) { %>
            <% pendingInstructors.forEach(instructor => { %>
                <div class="user-row" id="row-<%= instructor._id %>" style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,.08); padding-bottom: 15px;">
                    <div style="display: flex; align-items: center; gap: 18px;">
                        <img src="https://i.pravatar.cc/100?img=<%= Math.floor(Math.random() * 70) %>" style="width: 50px; height: 50px; border-radius: 50%;">
                        <div>
                            <h4 style="margin: 0; color: white;"><%= instructor.username %></h4>
                            <p style="margin: 4px 0 0; color: #BEBEBE; font-size: 14px;"><%= instructor.email %> &nbsp;·&nbsp; Age: <%= instructor.age %></p>
                        </div>
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button onclick="approveInstructor('<%= instructor._id %>')" style="background: linear-gradient(135deg, #10B981, #059669); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);">
                            ✓ Approve
                        </button>
                        <button onclick="rejectInstructor('<%= instructor._id %>')" style="background: linear-gradient(135deg, #EF4444, #DC2626); color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);">
                            ✕ Reject
                        </button>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p style="color: #BEBEBE;">No pending instructor approvals at the moment.</p>
        <% } %>
    </div>
</div>

<!-- ================= LOWER GRID ================= -->

<div class="bottom-grid">

<!-- RECENT USERS -->

<div class="recent-users">

<h2>Recent Registrations</h2>

<div style="display: flex; flex-direction: column; gap: 10px;">
<% if (locals.recentUsers && recentUsers.length > 0) { %>
    <% recentUsers.forEach(u => { %>
        <div class="user-row">
            <img src="https://i.pravatar.cc/100?img=<%= (u._id.toString().charCodeAt(u._id.toString().length - 1) % 70) %>">
            <div>
                <h4><%= u.username %></h4>
                <p><%= u.email %></p>
            </div>
            <span class="<%= u.role === 'instructor' ? 'badge badge-instructor' : 'badge badge-student' %>">
                <%= u.role.charAt(0).toUpperCase() + u.role.slice(1) %>
            </span>
            <small>Age: <%= u.age || '—' %></small>
        </div>
    <% }) %>
<% } else { %>
    <p style="color: #BEBEBE;">No user registrations found.</p>
<% } %>
</div>

</div>

<!-- ================= GRAPH ================= -->

<div class="analytics">

<h2>

Platform Analytics

</h2>

<div class="graph">

<div class="line"></div>

<div class="months">

<span>Jan</span>

<span>Feb</span>

<span>Mar</span>

<span>Apr</span>

<span>May</span>

<span>Jun</span>

<span>Jul</span>

</div>

</div>

</div>

</div>

</main>

</div>

<script>
function removeRow(id) {
    const row = document.getElementById(`row-${id}`);
    if (row) {
        row.style.transition = 'all 0.5s ease';
        row.style.opacity = '0';
        row.style.transform = 'translateX(50px)';
        setTimeout(() => {
            row.remove();
            const container = document.querySelector('.recent-users div[style*="flex-direction: column"]');
            if (container && container.querySelectorAll('.user-row').length === 0) {
                container.innerHTML = '<p style="color: #BEBEBE;">No pending instructor approvals at the moment.</p>';
            }
        }, 500);
    }
}

async function approveInstructor(id) {
    try {
        const response = await fetch(`/admin/approve/${id}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            removeRow(id);
        } else {
            alert('Failed to approve instructor. Please try again.');
        }
    } catch (err) {
        console.error('Error approving instructor:', err);
        alert('An error occurred. Please try again.');
    }
}

async function rejectInstructor(id) {
    if (!confirm('Are you sure you want to reject and delete this instructor account?')) return;
    try {
        const response = await fetch(`/admin/reject/${id}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            removeRow(id);
        } else {
            alert('Failed to reject instructor. Please try again.');
        }
    } catch (err) {
        console.error('Error rejecting instructor:', err);
        alert('An error occurred. Please try again.');
    }
}
</script>

</body>

</html>