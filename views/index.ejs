<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub</title>

    <!-- CSS -->
    <link rel="stylesheet" href="/stylesheets/index.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="container">

        <div class="glass-card">

            <h1>LearnHub</h1>

            <p class="tagline">
                Learn. Build. Grow.
            </p>

            <p class="description">
                An online learning platform where students can master new skills,
                instructors can create engaging courses, and administrators can
                manage the entire platform seamlessly.
            </p>

            <div class="buttons">

                <a href="/login">
                    <button class="login-btn">Login</button>
                </a>

                <a href="/create">
                    <button class="register-btn">
                        Create Account
                    </button>
                </a>

            </div>

        </div>

    </div>

</body>
</html>