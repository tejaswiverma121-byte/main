<%# 
    ====================================================
    PROFILE PARTIAL — include in any instructor/student page
    Required variables in scope:
      - user  (Mongoose user object with .username, .email, .role, .age, ._id)
    ====================================================
%>

<!-- ===================== PROFILE MODAL ===================== -->
<div class="profile-modal-overlay" id="profileModal">
    <div class="profile-modal-card">
        <button class="profile-modal-close" onclick="closeProfileModal()" id="profileModalCloseBtn">✕</button>

        <!-- Avatar + Name + Role -->
        <div class="profile-modal-avatar-section">
            <div class="profile-modal-avatar-circle" id="modalAvatarCircle"></div>
            <div class="profile-modal-name"><%= user.username %></div>
            <span class="profile-modal-role-badge <%= user.role === 'student' ? 'role-badge-student' : 'role-badge-instructor' %>">
                <i class="fa-solid <%= user.role === 'student' ? 'fa-graduation-cap' : 'fa-chalkboard-teacher' %>"></i>
                <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
            </span>
        </div>

        <!-- Info rows -->
        <div class="profile-info-list">
            <div class="profile-info-row">
                <i class="fa-regular fa-envelope"></i>
                <div class="profile-info-text">
                    <span class="profile-info-label">Email</span>
                    <span class="profile-info-value"><%= user.email %></span>
                </div>
            </div>

            <% if (user.age) { %>
            <div class="profile-info-row">
                <i class="fa-regular fa-calendar"></i>
                <div class="profile-info-text">
                    <span class="profile-info-label">Age</span>
                    <span class="profile-info-value"><%= user.age %> years old</span>
                </div>
            </div>
            <% } %>

            <div class="profile-info-row">
                <i class="fa-solid fa-shield-halved"></i>
                <div class="profile-info-text">
                    <span class="profile-info-label">Account Status</span>
                    <span class="profile-info-value" style="color: #10B981;">● Active</span>
                </div>
            </div>

            <div class="profile-info-row">
                <i class="fa-regular fa-id-card"></i>
                <div class="profile-info-text">
                    <span class="profile-info-label">Member ID</span>
                    <span class="profile-info-value" style="font-size:12px; color:#888;"><%= user._id %></span>
                </div>
            </div>
        </div>

        <!-- Logout -->
        <a href="/logout" class="profile-modal-logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            Sign Out
        </a>
    </div>
</div>

<!-- ===================== TOPBAR PROFILE DROPDOWN ===================== -->
<script>
(function() {
    // Generate initials from name
    function getInitials(name) {
        if (!name) return '?';
        const parts = name.trim().split(' ').filter(Boolean);
        if (parts.length === 1) return parts[0].substring(0, 2).toUpperCase();
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }

    const USERNAME = '<%= user.username %>';
    const INITIALS = getInitials(USERNAME);

    // Set initials on all avatar elements
    document.querySelectorAll('.avatar-initials, .dropdown-avatar-lg, #modalAvatarCircle').forEach(el => {
        el.textContent = INITIALS;
    });

    // Dropdown toggle
    const wrap = document.getElementById('profileAvatarWrap');
    const dropdown = document.getElementById('profileDropdown');

    if (wrap && dropdown) {
        wrap.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.classList.toggle('open');
        });

        document.addEventListener('click', function() {
            dropdown.classList.remove('open');
        });

        dropdown.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    }
})();

function openProfileModal() {
    const overlay = document.getElementById('profileModal');
    if (overlay) {
        overlay.classList.add('open');
        // close dropdown if open
        const dd = document.getElementById('profileDropdown');
        if (dd) dd.classList.remove('open');
    }
}

function closeProfileModal() {
    const overlay = document.getElementById('profileModal');
    if (overlay) overlay.classList.remove('open');
}

// Close modal on overlay click
document.getElementById('profileModal').addEventListener('click', function(e) {
    if (e.target === this) closeProfileModal();
});

// ESC key closes modal
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeProfileModal();
});
</script>
