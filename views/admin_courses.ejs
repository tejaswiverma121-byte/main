<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub Admin | Courses</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        /* Modal Overlay & Card Styling */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 13, 35, 0.85);
            backdrop-filter: blur(8px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-card {
            background: #211C44;
            border-radius: 20px;
            width: 90%;
            max-width: 550px;
            padding: 35px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .modal-card h2 {
            margin-top: 0;
            font-size: 24px;
            margin-bottom: 20px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-card .close-btn {
            background: none;
            border: none;
            color: #9f9f9f;
            font-size: 22px;
            cursor: pointer;
            transition: 0.3s;
        }

        .modal-card .close-btn:hover {
            color: white;
        }

        .modal-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .modal-form label {
            font-size: 13px;
            color: #BEBEBE;
            margin-bottom: -10px;
            font-weight: 500;
        }

        .modal-form input, .modal-form select, .modal-form textarea {
            background: #15132B;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
            width: 100%;
        }

        .modal-form input:focus, .modal-form select:focus, .modal-form textarea:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
        }

        .modal-form button[type="submit"] {
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.3s;
        }

        .modal-form button[type="submit"]:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .course-img-cell {
            width: 70px;
            height: 48px;
            border-radius: 10px;
            object-fit: cover;
        }

        .btn-create {
            background: linear-gradient(135deg, #4F46E5, #9333EA);
            color: white;
            border: none;
            padding: 12px 22px;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: 0.3s;
        }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(147, 51, 234, 0.4);
        }

        .btn-action {
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: white;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
            display: inline-flex;
            justify-content: center;
            align-items: center;
        }

        .btn-action:hover {
            background: #8B5CF6;
        }

        .btn-action.delete:hover {
            background: #EF4444;
        }
    </style>
</head>
<body>

<div class="dashboard">

<!-- ================= SIDEBAR ================= -->
<aside class="sidebar">
    <div>
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <a href="/dashboard/admin">
                <li class="<%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>
            <a href="/admin/students">
                <li class="<%= (typeof activePage !== 'undefined' && activePage === 'students') ? 'active' : '' %>">
                    <i class="fa-solid fa-graduation-cap"></i>
                    Students
                </li>
            </a>
            <a href="/admin/instructors">
                <li class="<%= (typeof activePage !== 'undefined' && activePage === 'instructors') ? 'active' : '' %>">
                    <i class="fa-solid fa-chalkboard-user"></i>
                    Instructors
                </li>
            </a>
            <a href="/admin/courses">
                <li class="<%= (typeof activePage !== 'undefined' && activePage === 'courses') ? 'active' : '' %>">
                    <i class="fa-solid fa-book"></i>
                    Courses
                </li>
            </a>
            <li><i class="fa-solid fa-chart-column"></i> Reports</li>
            <li><i class="fa-solid fa-layer-group"></i> Categories</li>
            <li><i class="fa-solid fa-gear"></i> Settings</li>
        </ul>
    </div>

    <a href="/logout" class="logout">
        <i class="fa-solid fa-right-from-bracket"></i>
        Logout
    </a>
</aside>

<!-- ================= MAIN ================= -->
<main class="main">
    <div class="topbar">
        <div>
            <h1>Course Management</h1>
            <p>Create, edit, and manage all courses on the LearnHub platform</p>
        </div>
        <div class="profile">
            <i class="fa-regular fa-bell"></i>
            <img src="https://i.pravatar.cc/100?img=12">
        </div>
    </div>

    <!-- Stats -->
    <div class="stats" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div>
                <h4>Total Courses</h4>
                <h2><%= totalCourses %></h2>
                <span class="green">Platform Offerings</span>
            </div>
            <div class="icon purple">
                <i class="fa-solid fa-book"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <h4>Published</h4>
                <h2><%= publishedCount %></h2>
                <span class="green">Live & Available</span>
            </div>
            <div class="icon green-bg">
                <i class="fa-solid fa-globe"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <h4>Drafts</h4>
                <h2><%= draftCount %></h2>
                <span class="green" style="color: #FBBF24;">In Preparation</span>
            </div>
            <div class="icon yellow">
                <i class="fa-solid fa-file-pen"></i>
            </div>
        </div>
    </div>

    <!-- Data Table Container -->
    <div class="data-table-container">
        <div class="data-table-header">
            <h2>All Courses (<%= totalCourses %>)</h2>
            <div style="display: flex; gap: 15px; align-items: center;">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="courseSearch" placeholder="Search by title or category..." onkeyup="filterCourses()">
                </div>
                <button class="btn-create" onclick="openCreateModal()">
                    <i class="fa-solid fa-plus"></i>
                    Create New Course
                </button>
            </div>
        </div>

        <table class="data-table">
            <thead>
                <tr>
                    <th>Thumbnail</th>
                    <th>Course Title</th>
                    <th>Category</th>
                    <th>Instructor</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="coursesTableBody">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(course => { %>
                        <tr class="course-row" id="course-row-<%= course._id %>">
                            <td>
                                <img src="<%= course.thumbnail %>" class="course-img-cell" alt="course thumbnail" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500'">
                            </td>
                            <td>
                                <h4 style="margin: 0; color: white;"><%= course.title %></h4>
                                <p style="margin: 3px 0 0; color: #BEBEBE; font-size: 13px;"><%= course.description ? course.description.substring(0, 50) + '...' : '' %></p>
                            </td>
                            <td><span class="badge" style="background: rgba(139, 92, 246, 0.2); color: #C084FC; border: 1px solid rgba(139, 92, 246, 0.4);"><%= course.category %></span></td>
                            <td style="color: #BEBEBE;"><%= course.instructorName || 'Instructor' %></td>
                            <td style="font-weight: 600; color: #4ADE80;">₹<%= course.price %></td>
                            <td>
                                <% if (course.status === 'Published') { %>
                                    <span class="badge badge-approved">Published</span>
                                <% } else { %>
                                    <span class="badge badge-pending">Draft</span>
                                <% } %>
                            </td>
                            <td>
                                <button class="btn-action" onclick='openEditModal(<%= JSON.stringify(course) %>)'>
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="btn-action delete" onclick="deleteCourse('<%= course._id %>')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: #BEBEBE; padding: 35px;">
                            No courses created yet. Click <strong>+ Create New Course</strong> to add your first course!
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>

</div>

<!-- ================= CREATE COURSE MODAL ================= -->
<div class="modal-overlay" id="createCourseModal">
    <div class="modal-card">
        <h2>
            <span><i class="fa-solid fa-book-medical" style="color: #8B5CF6; margin-right: 8px;"></i> Create New Course</span>
            <button class="close-btn" onclick="closeCreateModal()">✕</button>
        </h2>
        <form action="/courses/create" method="POST" class="modal-form">
            <label>Course Title</label>
            <input type="text" name="title" placeholder="e.g. Modern Full-Stack Web Development" required>

            <label>Instructor Name</label>
            <input type="text" name="instructorName" placeholder="Select or type instructor name..." list="instructorsList">
            <datalist id="instructorsList">
                <% if (locals.instructors && instructors.length > 0) { %>
                    <% instructors.forEach(inst => { %>
                        <option value="<%= inst.username %>"><%= inst.email %></option>
                    <% }) %>
                <% } %>
            </datalist>

            <label>Category</label>
            <select name="category" required>
                <option value="Development">Development</option>
                <option value="Design">Design</option>
                <option value="Data Science">Data Science</option>
                <option value="Business">Business</option>
                <option value="Marketing">Marketing</option>
            </select>

            <label>Price (₹)</label>
            <input type="number" name="price" placeholder="499" min="0" required>

            <label>Thumbnail Image URL</label>
            <input type="url" name="thumbnail" placeholder="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=500">

            <label>Status</label>
            <select name="status">
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
            </select>

            <label>Course Description</label>
            <textarea name="description" rows="3" placeholder="Brief summary of what students will learn..." required></textarea>

            <button type="submit">Create Course</button>
        </form>
    </div>
</div>

<!-- ================= EDIT COURSE MODAL ================= -->
<div class="modal-overlay" id="editCourseModal">
    <div class="modal-card">
        <h2>
            <span><i class="fa-solid fa-file-pen" style="color: #8B5CF6; margin-right: 8px;"></i> Edit Course</span>
            <button class="close-btn" onclick="closeEditModal()">✕</button>
        </h2>
        <form id="editCourseForm" method="POST" class="modal-form">
            <label>Course Title</label>
            <input type="text" id="editTitle" name="title" required>

            <label>Instructor Name</label>
            <input type="text" id="editInstructorName" name="instructorName" placeholder="Instructor Name" list="instructorsList">

            <label>Category</label>
            <select id="editCategory" name="category" required>
                <option value="Development">Development</option>
                <option value="Design">Design</option>
                <option value="Data Science">Data Science</option>
                <option value="Business">Business</option>
                <option value="Marketing">Marketing</option>
            </select>

            <label>Price (₹)</label>
            <input type="number" id="editPrice" name="price" min="0" required>

            <label>Thumbnail Image URL</label>
            <input type="url" id="editThumbnail" name="thumbnail">

            <label>Status</label>
            <select id="editStatus" name="status">
                <option value="Published">Published</option>
                <option value="Draft">Draft</option>
            </select>

            <label>Course Description</label>
            <textarea id="editDescription" name="description" rows="3" required></textarea>

            <button type="submit">Save Changes</button>
        </form>
    </div>
</div>

<script>
function filterCourses() {
    const query = document.getElementById('courseSearch').value.toLowerCase();
    const rows = document.querySelectorAll('.course-row');
    rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
    });
}

function openCreateModal() {
    document.getElementById('createCourseModal').style.display = 'flex';
}

function closeCreateModal() {
    document.getElementById('createCourseModal').style.display = 'none';
}

function openEditModal(course) {
    document.getElementById('editCourseForm').action = `/courses/edit/${course._id}`;
    document.getElementById('editTitle').value = course.title || '';
    document.getElementById('editInstructorName').value = course.instructorName || '';
    document.getElementById('editCategory').value = course.category || 'Development';
    document.getElementById('editPrice').value = course.price || 0;
    document.getElementById('editThumbnail').value = course.thumbnail || '';
    document.getElementById('editStatus').value = course.status || 'Published';
    document.getElementById('editDescription').value = course.description || '';
    document.getElementById('editCourseModal').style.display = 'flex';
}

function closeEditModal() {
    document.getElementById('editCourseModal').style.display = 'none';
}

async function deleteCourse(id) {
    if (!confirm('Are you sure you want to delete this course? This action cannot be undone.')) return;
    try {
        const response = await fetch(`/courses/delete/${id}`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            const row = document.getElementById(`course-row-${id}`);
            if (row) row.remove();
        } else {
            alert('Failed to delete course. Please try again.');
        }
    } catch (err) {
        console.error('Error deleting course:', err);
        alert('An error occurred. Please try again.');
    }
}
</script>

</body>
</html>
