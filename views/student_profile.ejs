<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LearnHub | My Profile</title>
    <link rel="stylesheet" href="/stylesheets/studentdashboard.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .profile-container {
            max-width: 700px;
        }

        .profile-hero {
            background: linear-gradient(135deg, #1B1735, #211C44);
            border-radius: 24px;
            padding: 40px;
            display: flex;
            align-items: center;
            gap: 35px;
            margin-bottom: 30px;
            border: 1px solid rgba(255,255,255,0.07);
            position: relative;
            overflow: hidden;
        }

        .profile-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(139,92,246,0.15), transparent 70%);
            border-radius: 50%;
        }

        .profile-avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .profile-avatar-wrap img {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            border: 4px solid #8B5CF6;
            object-fit: cover;
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.35);
        }

        .profile-avatar-wrap .edit-avatar-hint {
            position: absolute;
            bottom: 6px;
            right: 6px;
            background: #8B5CF6;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
        }

        .profile-info h2 {
            font-size: 26px;
            margin-bottom: 6px;
        }

        .profile-info .role-badge {
            display: inline-block;
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
        }

        .profile-info .stats {
            display: flex;
            gap: 25px;
            margin-top: 12px;
        }

        .profile-info .stat-item {
            text-align: center;
        }

        .profile-info .stat-item strong {
            font-size: 22px;
            display: block;
            color: white;
        }

        .profile-info .stat-item span {
            font-size: 12px;
            color: #BEBEBE;
        }

        .edit-card {
            background: #211C44;
            border-radius: 20px;
            padding: 35px;
            border: 1px solid rgba(255,255,255,0.07);
        }

        .edit-card h3 {
            font-size: 20px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
        }

        .edit-card h3 i {
            color: #8B5CF6;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            color: #BEBEBE;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            background: #15132B;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            padding: 13px 16px;
            color: white;
            font-family: 'Poppins', sans-serif;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
            resize: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 0 3px rgba(139,92,246,0.15);
        }

        .form-group .hint {
            font-size: 11px;
            color: #6b6b7a;
            margin-top: 6px;
        }

        .avatar-preview-row {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 10px;
        }

        .avatar-preview-row img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: 3px solid #8B5CF6;
            object-fit: cover;
        }

        .avatar-preset-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .avatar-preset-row img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.1);
            cursor: pointer;
            transition: 0.2s;
            object-fit: cover;
        }

        .avatar-preset-row img:hover {
            border-color: #8B5CF6;
            transform: scale(1.1);
        }

        .save-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            transition: 0.3s;
            box-shadow: 0 6px 20px rgba(109, 40, 217, 0.3);
            margin-top: 8px;
        }

        .save-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(109, 40, 217, 0.45);
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #10B981;
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 22px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #EF4444;
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 22px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
</head>
<body>

<div class="dashboard">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>

        <ul>
            <a href="/dashboard/student">
                <li>
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </li>
            </a>

            <a href="/student/my-courses">
                <li>
                    <i class="fa-solid fa-book-open"></i>
                    My Courses
                </li>
            </a>

            <a href="/student/wishlist">
                <li>
                    <i class="fa-regular fa-heart"></i>
                    Wishlist
                </li>
            </a>

            <li>
                <i class="fa-regular fa-message"></i>
                Messages
            </li>

            <a href="/student/profile">
                <li class="active">
                    <i class="fa-solid fa-user"></i>
                    Profile
                </li>
            </a>
        </ul>

        <a href="/logout" class="logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </aside>

    <!-- ================= MAIN ================= -->
    <main class="main">

        <!-- Top Bar -->
        <div class="topbar">
            <div>
                <h1>My Profile</h1>
                <p>View and update your personal information.</p>
            </div>
            <div class="profile">
                <i class="fa-regular fa-bell"></i>
                <a href="/student/profile" style="display:inline-block; border-radius: 50%; border: 3px solid #8B5CF6;">
                    <img src="<%= user.profilePic && user.profilePic.trim() !== '' ? user.profilePic : 'https://i.pravatar.cc/100?img=32' %>" alt="profile" style="width:55px; height:55px; border-radius:50%; display:block;">
                </a>
            </div>
        </div>

        <div class="profile-container">

            <!-- Profile Hero Card -->
            <div class="profile-hero">
                <div class="profile-avatar-wrap">
                    <img id="heroAvatar" src="<%= user.profilePic && user.profilePic.trim() !== '' ? user.profilePic : 'https://i.pravatar.cc/100?img=32' %>" alt="<%= user.username %>">
                    <div class="edit-avatar-hint" onclick="document.getElementById('profilePicInput').focus()">
                        <i class="fa-solid fa-pen" style="color:white;"></i>
                    </div>
                </div>
                <div class="profile-info">
                    <h2><%= user.username %></h2>
                    <span class="role-badge"><i class="fa-solid fa-graduation-cap" style="margin-right:5px;"></i>Student</span>
                    <p style="color: #BEBEBE; font-size: 14px; margin-bottom: 5px;"><%= user.email %></p>
                    <% if (user.bio && user.bio.trim()) { %>
                        <p style="color: #d1d1d1; font-size: 13px; line-height: 1.5;"><%= user.bio %></p>
                    <% } %>
                    <div class="stats">
                        <div class="stat-item">
                            <strong><%= user.purchasedCourses ? user.purchasedCourses.length : 0 %></strong>
                            <span>Enrolled</span>
                        </div>
                        <div class="stat-item">
                            <strong><%= user.wishlist ? user.wishlist.length : 0 %></strong>
                            <span>Wishlisted</span>
                        </div>
                        <div class="stat-item">
                            <strong><%= user.age || '—' %></strong>
                            <span>Age</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Form -->
            <div class="edit-card">
                <h3><i class="fa-solid fa-pen-to-square"></i> Edit Profile</h3>

                <% if (locals.successMsg && successMsg) { %>
                    <div class="alert-success"><i class="fa-solid fa-circle-check"></i> <%= successMsg %></div>
                <% } %>
                <% if (locals.errorMsg && errorMsg) { %>
                    <div class="alert-error"><i class="fa-solid fa-circle-xmark"></i> <%= errorMsg %></div>
                <% } %>

                <form action="/student/profile/update" method="POST">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="username" value="<%= user.username %>" placeholder="Your name" required>
                    </div>

                    <div class="form-group">
                        <label>Age</label>
                        <input type="number" name="age" value="<%= user.age || '' %>" placeholder="Your age" min="10" max="100">
                    </div>

                    <div class="form-group">
                        <label>Bio</label>
                        <textarea name="bio" rows="3" placeholder="Write a short bio about yourself..."><%= user.bio || '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label>Profile Picture URL</label>
                        <div class="avatar-preview-row">
                            <img id="avatarPreview" src="<%= user.profilePic && user.profilePic.trim() !== '' ? user.profilePic : 'https://i.pravatar.cc/100?img=32' %>" alt="preview">
                            <span style="font-size: 13px; color: #BEBEBE;">Live preview</span>
                        </div>

                        <!-- Preset avatars -->
                        <p style="font-size: 12px; color: #BEBEBE; margin-bottom: 8px;">Quick select a preset avatar:</p>
                        <div class="avatar-preset-row">
                            <% [10, 20, 25, 32, 45, 50, 60, 65, 70, 80].forEach(n => { %>
                                <img
                                    src="https://i.pravatar.cc/100?img=<%= n %>"
                                    alt="avatar-<%= n %>"
                                    onclick="selectAvatar('https://i.pravatar.cc/100?img=<%= n %>')"
                                    title="Select this avatar"
                                >
                            <% }) %>
                        </div>

                        <input type="url" name="profilePic" id="profilePicInput" value="<%= user.profilePic || '' %>" placeholder="https://..." oninput="previewAvatar(this.value)">
                        <p class="hint">Paste any image URL, or click a preset above to pick one.</p>
                    </div>

                    <button type="submit" class="save-btn">
                        <i class="fa-solid fa-floppy-disk" style="margin-right: 8px;"></i>Save Changes
                    </button>

                </form>
            </div>

        </div><!-- /profile-container -->

    </main>

</div>

<script>
function previewAvatar(url) {
    if (url && url.trim()) {
        document.getElementById('avatarPreview').src = url;
        document.getElementById('heroAvatar').src = url;
    }
}

function selectAvatar(url) {
    document.getElementById('profilePicInput').value = url;
    previewAvatar(url);
}
</script>

</body>
</html>
