<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> — Lectures | LearnHub</title>
    <link rel="stylesheet" href="/stylesheets/instructor.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .lecture-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .lecture-card h4 {
            color: white;
            margin-bottom: 4px;
        }

        .lecture-card span {
            color: #9f9f9f;
            font-size: 13px;
        }

        .lecture-video {
            margin-top: 10px;
        }

        .lecture-video video, .lecture-video iframe {
            width: 100%;
            max-width: 480px;
            border-radius: 10px;
            border: none;
        }

        .add-lecture-form {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 30px;
            margin-top: 30px;
        }

        .add-lecture-form input {
            width: 100%;
            background: #15132B;
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            margin-bottom: 16px;
            outline: none;
        }

        .add-lecture-form label {
            color: #BEBEBE;
            font-size: 13px;
            display: block;
            margin-bottom: 6px;
        }

        .add-lecture-form .or-divider {
            text-align: center;
            color: #666;
            margin: 10px 0 20px;
        }

        .add-lecture-form button {
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            border: none;
            padding: 13px 26px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
</head>
<body>

<div class="dashboard">

<aside class="sidebar">
    <div>
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>
        <ul>
            <li>
                <a href="/dashboard/instructor" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-house"></i> Dashboard
                </a>
            </li>
            <li class="active">
                <a href="/dashboard/instructor/courses" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-book-open"></i> My Courses
                </a>
            </li>
            <li>
                <a href="/dashboard/instructor/students" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-users"></i> Students
                </a>
            </li>
        </ul>
    </div>
    <a href="/logout" class="logout">
        <i class="fa-solid fa-right-from-bracket"></i> Logout
    </a>
</aside>

<main class="main">
    <div class="topbar">
        <div>
            <h1><%= course.title %></h1>
            <p>Manage lectures for this course.</p>
        </div>
    </div>

    <div class="table-header">
        <h2>Lectures</h2>
    </div>

    <% if (locals.lectures && lectures.length > 0) { %>
        <% lectures.forEach(lecture => { %>
            <div class="lecture-card" id="lecture-<%= lecture._id %>">
                <div style="flex:1;">
                    <h4><%= lecture.title %></h4>
                    <span><%= lecture.videoType === 'youtube' ? 'YouTube Video' : 'Uploaded Video' %></span>

                    <div class="lecture-video">
                        <% if (lecture.videoType === 'youtube') { %>
                            <%
                                let ytId = lecture.videoUrl;
                                if (ytId.includes('watch?v=')) {
                                    ytId = ytId.split('watch?v=')[1].split('&')[0];
                                } else if (ytId.includes('youtu.be/')) {
                                    ytId = ytId.split('youtu.be/')[1].split('?')[0];
                                }
                            %>
                            <iframe height="270" src="https://www.youtube.com/embed/<%= ytId %>" allowfullscreen></iframe>
                        <% } else { %>
                            <video controls src="<%= lecture.videoUrl %>"></video>
                        <% } %>
                    </div>
                </div>
                <button class="action" onclick="deleteLecture('<%= lecture._id %>')">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
        <% }) %>
    <% } else { %>
        <p style="color:#BEBEBE;">No lectures added yet.</p>
    <% } %>

    <div class="add-lecture-form">
        <h3 style="color:white; margin-bottom:20px;">Add New Lecture</h3>
        <form action="/dashboard/instructor/courses/<%= course._id %>/lectures/add" method="POST" enctype="multipart/form-data">
            <label>Lecture Title</label>
            <input type="text" name="title" placeholder="e.g. Introduction to HTML" required>

            <label>Upload Video File</label>
            <input type="file" name="videoFile" accept="video/mp4,video/webm,video/ogg">

            <div class="or-divider">— OR —</div>

            <label>YouTube Link</label>
            <input type="text" name="youtubeLink" placeholder="https://www.youtube.com/watch?v=...">

            <button type="submit">
                <i class="fa-solid fa-plus"></i> Add Lecture
            </button>
        </form>
    </div>

</main>

</div>

<script>
async function deleteLecture(id) {
    if (!confirm('Delete this lecture?')) return;
    try {
        const response = await fetch(`/dashboard/instructor/lectures/delete/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            document.getElementById(`lecture-${id}`).remove();
        } else {
            alert('Failed to delete lecture.');
        }
    } catch (err) {
        console.error(err);
        alert('An error occurred.');
    }
}
</script>

</body>
</html>