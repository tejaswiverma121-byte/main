<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> — Lectures | LearnHub</title>
    <link rel="stylesheet" href="/stylesheets/instructor.css">
    <link rel="stylesheet" href="/stylesheets/profile.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        .lectures-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 22px;
            margin-top: 24px;
        }

        .lecture-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .lecture-card-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 14px;
        }

        .lecture-card-head h4 {
            color: white;
            font-size: 17px;
            margin-bottom: 4px;
        }

        .lecture-card-head span {
            color: #9f9f9f;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .lecture-delete-btn {
            background: rgba(239, 68, 68, 0.12);
            border: none;
            color: #EF4444;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            cursor: pointer;
            flex-shrink: 0;
            transition: 0.25s;
        }

        .lecture-delete-btn:hover {
            background: rgba(239, 68, 68, 0.25);
        }

        .lecture-video-wrap {
            width: 100%;
            aspect-ratio: 16 / 9;
            border-radius: 12px;
            overflow: hidden;
            background: #000;
        }

        .lecture-video-wrap video,
        .lecture-video-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

        .empty-lectures {
            color: #BEBEBE;
            background: rgba(255,255,255,0.03);
            border: 1px dashed rgba(255,255,255,0.15);
            border-radius: 14px;
            padding: 40px;
            text-align: center;
            margin-top: 20px;
        }

        .add-lecture-form {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            padding: 32px;
            margin-top: 34px;
            max-width: 520px;
        }

        .add-lecture-form h3 {
            color: white;
            margin-bottom: 22px;
            font-size: 19px;
        }

        .add-lecture-form label {
            color: #BEBEBE;
            font-size: 13px;
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
        }

        .add-lecture-form input[type="text"] {
            width: 100%;
            background: #15132B;
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            margin-bottom: 18px;
            outline: none;
            transition: 0.25s;
        }

        .add-lecture-form input[type="text"]:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.25);
        }

        .file-upload-wrap {
            position: relative;
            margin-bottom: 18px;
        }

        .file-upload-wrap input[type="file"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .file-upload-box {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #15132B;
            border: 1.5px dashed rgba(255,255,255,0.18);
            border-radius: 10px;
            padding: 16px;
            color: #9f9f9f;
            font-size: 14px;
            transition: 0.25s;
        }

        .file-upload-box i {
            font-size: 18px;
            color: #8B5CF6;
        }

        .file-upload-wrap:hover .file-upload-box {
            border-color: #8B5CF6;
            background: rgba(139, 92, 246, 0.06);
        }

        .file-upload-box .file-name {
            color: white;
            font-weight: 500;
        }

        .or-divider {
            text-align: center;
            color: #666;
            font-size: 13px;
            margin: 4px 0 18px;
            position: relative;
        }

        .add-lecture-form button {
            background: linear-gradient(135deg, #6D28D9, #9333EA);
            color: white;
            border: none;
            padding: 13px 28px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .add-lecture-form button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(139, 92, 246, 0.35);
        }
    </style>
</head>
<body>

<div class="dashboard">

<aside class="sidebar">
    <div>
        <div class="logo">
            <i class="fa-solid fa-graduation-cap"></i>
            <span>LearnHub</span>
        </div>
        <ul>
            <li>
                <a href="/dashboard/instructor" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-house"></i> Dashboard
                </a>
            </li>
            <li class="active">
                <a href="/dashboard/instructor/courses" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-book-open"></i> My Courses
                </a>
            </li>
            <li>
                <a href="/dashboard/instructor/students" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-solid fa-users"></i> Students
                </a>
            </li>
            <li>
                <a href="/messages" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:10px; width:100%;">
                    <i class="fa-regular fa-message"></i> Messages
                </a>
            </li>
        </ul>
    </div>
    <a href="/logout" class="logout">
        <i class="fa-solid fa-right-from-bracket"></i> Logout
    </a>
</aside>

<main class="main">
    <div class="topbar">
        <div>
            <h1><%= course.title %></h1>
            <p>Manage lectures for this course.</p>
        </div>
        <div class="profile" style="position:relative;">
            <div class="profile-avatar-wrap" id="profileAvatarWrap">
                <div class="avatar-initials"></div>
                <div class="profile-dropdown" id="profileDropdown">
                    <div class="dropdown-header">
                        <div class="dropdown-avatar-lg"></div>
                        <div>
                            <div class="dropdown-name"><%= user.username %></div>
                            <div class="dropdown-role"><%= user.role %></div>
                        </div>
                    </div>
                    <span class="dropdown-item" onclick="openProfileModal()">
                        <i class="fa-regular fa-user"></i> View Profile
                    </span>
                    <div class="dropdown-divider"></div>
                    <a href="/logout" class="dropdown-item danger">
                        <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="table-header">
        <h2>Lectures</h2>
    </div>

    <% if (locals.lectures && lectures.length > 0) { %>
        <div class="lectures-grid">
            <% lectures.forEach(lecture => { %>
                <div class="lecture-card" id="lecture-<%= lecture._id %>">
                    <div class="lecture-card-head">
                        <div>
                            <h4><%= lecture.title %></h4>
                            <span><%= lecture.videoType === 'youtube' ? 'YouTube Video' : 'Uploaded Video' %></span>
                        </div>
                        <button class="lecture-delete-btn" onclick="deleteLecture('<%= lecture._id %>')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>

                    <div class="lecture-video-wrap">
                        <% if (lecture.videoType === 'youtube') { %>
                            <%
                                let ytId = lecture.videoUrl;
                                if (ytId.includes('watch?v=')) {
                                    ytId = ytId.split('watch?v=')[1].split('&')[0];
                                } else if (ytId.includes('youtu.be/')) {
                                    ytId = ytId.split('youtu.be/')[1].split('?')[0];
                                }
                            %>
                            <iframe src="https://www.youtube.com/embed/<%= ytId %>" allowfullscreen></iframe>
                        <% } else { %>
                            <video controls src="<%= lecture.videoUrl %>"></video>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-lectures">
            No lectures added yet. Add your first one below.
        </div>
    <% } %>

    <div class="add-lecture-form">
        <h3>Add New Lecture</h3>
        <form action="/dashboard/instructor/courses/<%= course._id %>/lectures/add" method="POST" enctype="multipart/form-data">
            <label>Lecture Title</label>
            <input type="text" name="title" placeholder="e.g. Introduction to HTML" required>

            <label>Upload Video File</label>
            <div class="file-upload-wrap">
                <input type="file" name="videoFile" id="videoFile" accept="video/mp4,video/webm,video/ogg" onchange="updateFileName(this)">
                <div class="file-upload-box">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <span id="fileNameDisplay">Click to choose a video, or drag one here</span>
                </div>
            </div>

            <div class="or-divider">— OR —</div>

            <label>YouTube Link</label>
            <input type="text" name="youtubeLink" placeholder="https://www.youtube.com/watch?v=...">

            <button type="submit">
                <i class="fa-solid fa-plus"></i> Add Lecture
            </button>
        </form>
    </div>

</main>

</div>

<script>
async function deleteLecture(id) {
    if (!confirm('Delete this lecture?')) return;
    try {
        const response = await fetch(`/dashboard/instructor/lectures/delete/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            document.getElementById(`lecture-${id}`).remove();
        } else {
            alert('Failed to delete lecture.');
        }
    } catch (err) {
        console.error(err);
        alert('An error occurred.');
    }
}

function updateFileName(input) {
    const display = document.getElementById('fileNameDisplay');
    if (input.files && input.files.length > 0) {
        display.textContent = input.files[0].name;
        display.classList.add('file-name');
    } else {
        display.textContent = 'Click to choose a video, or drag one here';
        display.classList.remove('file-name');
    }
}
</script>

<%- include('partials/profile-modal') %>

</body>
</html>