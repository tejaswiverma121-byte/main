<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Already Exists | LearnHub</title>

    <link rel="stylesheet" href="/stylesheets/useralreadyexists.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="card">

        <div class="icon">
            ⚠️
        </div>

        <h1>Account Already Exists</h1>

        <p>
            An account with this email address already exists.
            Please login using your existing account or use a different email address to create a new account.
        </p>

        <div class="buttons">
            <a href="/login" class="login-btn">Login</a>
            <a href="/create" class="create-btn">Try Another Email</a>
        </div>

    </div>

</body>
</html>